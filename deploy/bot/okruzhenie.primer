# Окружение бота Нейролавки.
#
# Боевой файл лежит на сервере: /etc/neirolavka-bot/okruzhenie,
# владелец root, права 600. В репозиторий он не попадает
# НИКОГДА — здесь только имена переменных и пояснения.
#
# Значения, помеченные «сделать один раз», создаёт scripts/bot-setup.sh,
# если их ещё нет. Токен кладёт человек.

# Токен бота от @BotFather. Кладёт владелец руками.
NEIROLAVKA_TOKEN_BOTA=

# Секрет в адресе вебхука и в заголовке Telegram. Сделать один раз:
#   openssl rand -hex 24
NEIROLAVKA_SEKRET_VEBHUKA=

# Ключ шифрования доступов, 32 байта. Сделать один раз:
#   openssl rand -base64 32
#
# ЕДИНСТВЕННЫЙ экземпляр. Потеряется — выданные логины и пароли
# не прочитает никто, включая владельца. Хранить копию отдельно
# от сервера и отдельно от резервных копий базы.
NEIROLAVKA_KLYUCH_DOSTUPOV=

# Кто владелец. Список телеграм-идентификаторов через запятую.
NEIROLAVKA_VLADELCY=1369202079

# Кто помощник. Можно оставить пустым и добавить помощника из бота.
NEIROLAVKA_POMOSHNIKI=

# Как бот получает обновления:
#   sam    — начать с вебхука и перейти на опрос, если Telegram
#            доказательно не может до нас достучаться (по умолчанию);
#   vebhuk — только вебхук;
#   opros  — только опрос, бот забирает обновления сам.
#
# На этом сервере ВХОДЯЩИЙ IPv4 закрыт так же, как исходящий, а вебхук
# у Telegram работает ТОЛЬКО по IPv4 — поэтому здесь стоит opros.
NEIROLAVKA_REZHIM=opros

# Часы работы лавки и обещание выдачи. Владелец меняет их из бота;
# здесь — значения по умолчанию для свежей установки.
NEIROLAVKA_POYAS=Europe/Moscow
NEIROLAVKA_RABOTA_S=8
NEIROLAVKA_RABOTA_DO=22
NEIROLAVKA_OBESHCHANIE_MINUT=60

# Через сколько минут после просрочки напоминать и сколько раз.
NEIROLAVKA_NAPOMINAT_CHEREZ=10
NEIROLAVKA_NAPOMINAT_RAZ=5

# Где база и на каком порту петли слушать вебхук.
NEIROLAVKA_BAZA=/var/lib/neirolavka-bot/baza.sqlite
NEIROLAVKA_PORT=8080
NEIROLAVKA_ADRES=https://neirolavka.ru

# По какому адресу Telegram должен ходить к нам с вебхуками.
# Пусто — пусть разрешает имя сам, это правильное умолчание.
#
# Заполнять только если стало видно, что его выбор не работает:
# pending_update_count растёт, а last_error_date свежий. Значение
# живёт здесь, а не ставится руками, потому что бот переобъявляет
# вебхук при каждом старте и затёр бы ручную настройку.
NEIROLAVKA_ADRES_DLYA_TELEGRAM=

# Сколько резервных копий держать на диске.
NEIROLAVKA_KOPIY_HRANIT=28

# Отправлять ли суточную копию базы владельцу в Telegram.
# 1 — да, пусто — нет. Это единственный способ получить копию ВНЕ
# сервера без второй машины; в копии лежат заказы и шифротексты
# доступов, но не ключ от них.
NEIROLAVKA_KOPIYA_V_TELEGRAM=

# ─────────────────────────────────────────────────────────────────────
# РОБОКАССА
#
# Четыре пароля, и путать их нельзя. Боевые — для настоящих денег,
# тестовые — для тестового режима. БОЕВЫЕ ПАРОЛИ В ТЕСТОВОМ РЕЖИМЕ
# ДАЮТ ОШИБКУ 29 («неверная подпись»), неотличимую от ошибки
# в формуле, и на её поиск уходит полдня.
#
# Все четыре берутся в кабинете Робокассы: Магазины → Технические
# настройки. Там же выбирается алгоритм подписи — он обязан совпасть
# с NEIROLAVKA_ROBOKASSA_ALGORITM ниже.
# ─────────────────────────────────────────────────────────────────────

# Идентификатор магазина. Пусто — оплаты в боте нет, заказы при этом
# принимаются, и бот честно говорит, что платить пока негде.
NEIROLAVKA_ROBOKASSA_LOGIN=Neirolavka

# Боевые пароли. № 1 подписывает ссылку на оплату, № 2 проверяет
# уведомление. № 2 не уезжает в браузер НИКОГДА — на нём и держится
# доверие к слову «оплачено».
NEIROLAVKA_ROBOKASSA_PAROL1=
NEIROLAVKA_ROBOKASSA_PAROL2=

# Тестовые пароли — та же пара, но для тестового режима.
NEIROLAVKA_ROBOKASSA_TEST_PAROL1=
NEIROLAVKA_ROBOKASSA_TEST_PAROL2=

# Тестовый режим: 1 — да (деньги не списываются), 0 — боевой.
#
# ПО УМОЛЧАНИЮ 1, и это выбор из двух ошибок. Забытая переменная при
# умолчании «бой» означала бы приём настоящих денег там, где их ещё
# не собирались принимать; при умолчании «тест» — всего лишь то, что
# деньги не списались, и это видно сразу.
NEIROLAVKA_ROBOKASSA_TEST=1

# Алгоритм подписи. Обязан совпадать с выбранным в кабинете.
# Можно: md5, ripemd160, sha1, sha256, sha384, sha512.
NEIROLAVKA_ROBOKASSA_ALGORITM=md5

# Система налогообложения в чеке. ПУСТО — берётся та, что заведена
# в кабинете магазина, и для продавца с одной системой это правильный
# ответ. Заполнять только если Робокасса потребует явно:
# osn, usn_income, usn_income_outcome, envd, esn, patent.
NEIROLAVKA_ROBOKASSA_SNO=

# В каком виде чек входит в подпись: kodirovanny (по документации)
# или syroy. Трогать только при ошибке 29 на платеже С чеком —
# см. bot/src/oplata/robokassa.ts и пробу: npm run proba-oplaty.
NEIROLAVKA_ROBOKASSA_CHEK_V_PODPISI=kodirovanny
