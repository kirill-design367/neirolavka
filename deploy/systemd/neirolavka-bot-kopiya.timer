# Копия базы раз в шесть часов.
#
# Почему шесть, а не сутки: между копиями теряется всё, что случилось
# после последней. Сутки потерянных заказов означают, что люди
# заплатили, а доступов нет и следов оплаты тоже. Шесть часов — это
# четыре копии в день на базе размером в мегабайты.
#
# Persistent=true — копия догоняется после перезагрузки, а не
# пропускается молча.

[Unit]
Description=Расписание резервных копий базы бота

[Timer]
OnCalendar=00/6:20
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
