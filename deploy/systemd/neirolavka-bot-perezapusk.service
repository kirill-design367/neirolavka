# Перезапуск бота по требованию выкладки.
#
# Зачем такая петля вместо `sudo systemctl restart`. Пользователь
# deploy намеренно не имеет sudo: утечка ключа выкладки должна
# отдавать содержимое папки сайта, и ничего больше. Дать ему право
# перезапускать службу — значит открыть дверь, которую потом никто
# не закроет.
#
# Поэтому выкладка не перезапускает бота, а КЛАДЁТ ФАЙЛ. За файлом
# следит .path-юнит, и перезапуск делает уже сам systemd от root.
# Дверь односторонняя: положить файл можно, попросить о чём-то ещё
# нельзя.

[Unit]
Description=Перезапуск бота Нейролавки по метке выкладки

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart neirolavka-bot.service
