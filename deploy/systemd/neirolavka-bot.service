# Бот Нейролавки.
#
# Бот НЕ работает от root: пользователь bot, без sudo, со своей
# базой в /var/lib и своими секретами в /etc. Утечка чего угодно
# из этой службы не даёт ни сайта, ни сервера.

[Unit]
Description=Нейролавка: телеграм-бот
Documentation=https://github.com/kirill-design367/neirolavka
# Вебхуки приходят через nginx, поэтому поднимаемся после него.
After=network-online.target nginx.service
Wants=network-online.target

# Предел попыток запуска. Именно в [Unit]: в [Service] эти два ключа
# systemd принимает молча и не применяет.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bot
Group=bot

# current — символическая ссылка на выпуск. systemd разворачивает её
# при запуске, поэтому перезапуск подхватывает новый выпуск.
WorkingDirectory=/home/bot/neirolavka-bot/current

# Секреты лежат ОТДЕЛЬНО от кода и вне папки, куда пишет выкладка.
# Файл принадлежит root и имеет права 600: его читает systemd от root
# и передаёт боту уже готовым окружением. Ни пользователь bot, ни тем
# более deploy прочитать его не могут — утечка ключа выкладки
# не отдаёт ни токена, ни ключа шифрования доступов.
EnvironmentFile=/etc/neirolavka-bot/okruzhenie

ExecStart=/usr/bin/node dist/bot/src/index.js

# Падение процесса не должно означать остановку лавки — но и молотить
# вхолостую сутками оно не должно.
#
# Так уже было: пока кода на сервере не оказалось, служба падала
# на CHDIR и перезапускалась каждые три секунды, набрав 250 попыток.
# Ни одна из них не могла помочь: причина была неустранимой изнутри.
# Такая петля не чинит, а прячет — в журнале ровный поток одинаковых
# строк, а по состоянию службы («activating») не видно, что она
# безнадёжна.
#
# Теперь пауза растёт от 5 секунд к минуте: разовый сбой сети лечится
# первой же попыткой, а безнадёжная поломка перестаёт жечь процессор.
# Десять неудач за пять минут останавливают службу в состоянии failed —
# по нему сразу видно, что нужен человек. Перезапуск руками или
# выкладка обнуляют счётчик.
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
# StartLimitIntervalSec и StartLimitBurst стоят ВЫШЕ, в секции [Unit].
# Здесь systemd их молча игнорирует — предупреждение видно только
# в `systemd-analyze verify`, а не при запуске. Прежний
# «StartLimitIntervalSec=0» стоял именно тут и не действовал никогда:
# работали умолчания, и они же пропустили 250 перезапусков подряд.

# Мягкая остановка: боту дают доработать начатое обновление.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neirolavka-bot

# Права ужаты до необходимого. Единственное место, куда бот пишет, —
# папка базы.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Единственное, куда бот пишет.
ReadWritePaths=/var/lib/neirolavka-bot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
