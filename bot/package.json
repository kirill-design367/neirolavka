{
  "name": "neirolavka-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Бот Нейролавки: приём заказа, уведомление администратора, ручная выдача доступа",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot/src/index.js",
    "test": "tsc -p tsconfig.json && node --test 'dist/bot/test/*.test.js'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "grammy": "^1.32.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
